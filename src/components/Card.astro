<!doctype html>
<html lang="es">
  <head>
    <!-- Configuración de codificación y vista responsiva -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Título de la pestaña del navegador -->
    <title>Sebastian Urrego - Portafolio</title>

    <!-- Descripción para motores de búsqueda -->
    <meta
      name="description"
      content="Portafolio profesional de Sebastian Urrego, estudiante de desarrollo de software con experiencia en soporte técnico, seguridad informática y tecnologías web."
    />

    <!-- Bootstrap CSS para estilos prediseñados -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />

    <!-- Hoja de estilos personalizada -->
    <link rel="stylesheet" href="css/style.css" />

    <!-- Icono de la pestaña (favicon) -->
    <link rel="icon" href="img/Sebastian.jpeg" />

    <!-- Font Awesome para iconos -->
    <link
      rel="stylesheet"
      href="https://stackpath.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css"
    />
  </head>
  <body>
    <!-- Barra de navegación superior fija -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark fixed-top">
      <div class="container">
        <!-- Nombre o logo de la marca -->
        <a class="navbar-brand" href="#">Sebastian Urrego</a>
        <!-- Botón para menú colapsable en móviles -->
      </div>
    </nav></body>
</html>
